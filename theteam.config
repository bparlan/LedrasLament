schema_version: 1
project:
  name: Ledras Lament
  root: .
  description: Scene generation infrastructure for projection mapping of ancient Mediterranean
    environments using AI
  stack:
  - Python
  - fal.ai
  - Flux Control LoRA
team:
- id: technical_visionary
  role: Technical Architect
  expertise: Advanced rendering pipelines, pixel density optimization, material physics
    simulation, fal.ai API optimization, specular highlight control, spot light positioning
  voice: Precise, methodical, detail-focused
  enabled: true
- id: cultural_scenarist
  role: Cultural Narrative Designer
  expertise: Ancient Mediterranean aesthetics, Cypriot-Phoenician cultural context,
    narrative progression, architectural geometry, cultural ornament integration
  voice: Rich, evocative, culturally-informed
  enabled: true
- id: production_orchestrator
  role: Production Systems Lead
  expertise: Pipeline automation, scene sequencing, resource optimization, batch processing,
    quality assurance workflows, subscene variation management
  voice: Efficient, systematic, pragmatic
  enabled: true
permitted_skills:
- graph-curation-expert
- brave-search
behavior:
  proactive_plan_required: true
  block_edits_without_plan: true
  pre_analysis_search: true
  max_discussion_rounds: 1
output:
  report_dir: .omp/theteam/reports
  keep_last: 20
